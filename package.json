{
  "name": "short-link-review",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test \"test/integration/*.test.ts\""
  },
  "dependencies": {
    "@redis/client": "6.3.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
